# Heavy/real test data staging area (see testdata/README.md): fetched and
# built on demand by scripts/testdata/*, never committed.
testdata/raw/*
testdata/reference/*
testdata/results/*
!testdata/raw/.gitkeep
!testdata/reference/.gitkeep
!testdata/results/.gitkeep

# setuptools-scm
stellarscope/_version.py
